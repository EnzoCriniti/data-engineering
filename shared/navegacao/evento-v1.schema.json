{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "session_id", "event_seq", "event_type", "event_ts"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "event_seq": { "type": "integer", "minimum": 1 },
    "event_type": { "enum": ["product_view", "add_to_cart", "checkout_started", "purchase_completed"] },
    "event_ts": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "produto_id": { "type": "integer", "minimum": 1 },
    "pedido_id": { "type": "integer", "minimum": 1 },
    "cliente_id": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "enum": ["product_view", "add_to_cart"] } } },
      "then": { "required": ["produto_id"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "purchase_completed" } } },
      "then": { "required": ["pedido_id"] },
      "else": { "not": { "required": ["pedido_id"] } }
    }
  ]
}
